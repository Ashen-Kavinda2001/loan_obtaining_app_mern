# Copy to server/.env and fill in real values. Never commit server/.env.
# In production these are set in cPanel → Setup Node.js App → Environment variables (or server/.env).

# ── Database (MySQL / MariaDB) ───────────────────────────────
MYSQL_URI=mysql://db_user:db_password@localhost:3306/db_name

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Time zone for "today", due dates and the overdue job (defaults to Asia/Colombo)
TZ=Asia/Colombo
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# true when the site is served over HTTPS
COOKIE_SECURE=true
# Extra origins allowed to call the API with credentials, comma-separated.
# https://fgiloans.lk and https://www.fgiloans.lk are always allowed.
CORS_ORIGIN=

# ── First admin account (created on first start if no admin exists) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Second admin used outside production only
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# true = reset the admin credentials to ADMIN_EMAIL / ADMIN_PASSWORD on the next start (emergency only)
RESET_ADMIN_ON_BOOT=false

# ── Email (password-reset codes) ─────────────────────────────
EMAIL_SERVICE=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=no-reply@example.com
EMAIL_PASS=change-me

# ── SMS (Text.lk payment receipts) ───────────────────────────
SMS_ENABLED=false
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
