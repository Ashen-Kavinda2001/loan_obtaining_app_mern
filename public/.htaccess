# ── LiteSpeed Web Server Keep-Alive & Timeout Hardening ─────────────────────────
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .* - [E=noconntimeout:1]
  RewriteRule .* - [E=noabort:1]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do not interfere with API requests
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [E=noconntimeout:1,L]

  # 2. Force HTTPS for frontend web requests
  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_URI} !^/api [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Do not rewrite existing files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Security Headers (S5) ──────────────────────────────────────────────────────
# Helmet only covers responses from the Node API; these cover the static app.
# The CSP is REPORT-ONLY: browsers log violations in the console (DevTools) but block nothing.
# After a week with no violations, rename the header to Content-Security-Policy to enforce it.
# Google Fonts is in connect-src because the service worker fetches the fonts to cache them.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# ── PWA Service Worker Headers ─────────────────────────────────────────────────
# Service worker must be served from root with no-cache to ensure updates apply.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  <Files "registerSW.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  # PWA Manifest
  <Files "manifest.webmanifest">
    Header set Content-Type "application/manifest+json"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

