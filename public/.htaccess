<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS for all incoming web requests (defeats mixed content & cookie dropping)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Do not interfere with API requests
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # Do not rewrite existing files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── PWA Service Worker Headers ─────────────────────────────────────────────────
# Service worker must be served from root with no-cache to ensure updates apply.
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  <Files "registerSW.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  # PWA Manifest
  <Files "manifest.webmanifest">
    Header set Content-Type "application/manifest+json"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

